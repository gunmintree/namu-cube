---
import Cube from './Cube.astro';
import LayerDiagram from './LayerDiagram.astro';
import { applyAlgorithm, solvedCube } from '../lib/cube';
import { lessons, text } from '../content/lessons';
import type { Locale } from '../content/lessons';
import { guidance } from '../content/guidance';
const { locale } = Astro.props as { locale: Locale };
const ko = locale === 'ko';
const base = ko ? '' : '/en';
const chapters = [
  { layer: 1 as const, title: ko ? '흰 면부터, 1층' : 'First, the white layer', note: ko ? '십자를 만들고 네 귀퉁이를 채워요.' : 'Build the cross, then fill the corners.', slugs: ['white-cross', 'white-corners'] },
  { layer: 2 as const, title: ko ? '가운데까지, 2층' : 'Next, the middle layer', note: ko ? '노란색이 없는 두 색 조각을 넣어요.' : 'Place the edges that have no yellow.', slugs: ['middle-layer'] },
  { layer: 3 as const, title: ko ? '노란 면까지, 3층' : 'Finally, the yellow layer', note: ko ? '노란 십자부터 마지막 꼭짓점까지.' : 'From the yellow cross to the last corner.', slugs: ['yellow-cross', 'yellow-edges', 'yellow-corners', 'finish'] },
];
const entryLabels = ko
  ? ['처음 시작하거나 흰 십자를 만들고 있어요', '흰 십자와 그 옆 색이 맞았어요', '흰 면과 1층이 맞았어요', '아래 두 층이 맞았어요', '아래 두 층과 노란 십자가 맞았어요', '노란 모서리의 옆 색까지 맞았어요', '노란 꼭짓점의 자리까지 맞았어요']
  : ['I am starting or working on the white cross', 'The white cross and its side colors match', 'The white face and first layer are solved', 'The lower two layers are solved', 'The lower layers and yellow cross are solved', 'The yellow edges also match their side centers', 'The yellow corners are in their correct homes'];
---
<div class="container cube-index">
  <section class="course-hero">
    <div class="course-intro"><h1>{ko ? '큐브 맞추기,' : 'Your first cube,'}<br /><span>{ko ? '첫 완성까지.' : 'one layer at a time.'}</span></h1><p class="lead">{ko ? '흰 십자부터 한 층씩. 움직이는 큐브를 보고, 내 큐브에 따라 해보세요.' : 'Start with the white cross. Watch each move, then try it on the cube in your hands.'}</p><div class="hero-actions"><a class="button primary" href={`${base}/learn/white-cross/`}>{ko ? '흰 십자부터 시작하기' : 'Start with the white cross'}<svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a><a class="button secondary" data-resume data-locale={locale} href={`${base}/learn/white-cross/`} hidden>{ko ? '이어서 배우기' : 'Resume learning'}</a></div><a class="text-link entry-jump" data-find-start href="#start-point">{ko ? '조금 맞췄다면, 시작 지점 찾기' : 'Already started? Find your next step'}</a><p class="course-note">{ko ? '준비물은 3×3 큐브 하나예요. 공식은 미리 외우지 않아도 돼요.' : 'All you need is a 3×3 cube. No algorithms to memorize first.'}</p></div>
    <div class="course-stage"><Cube state={applyAlgorithm(solvedCube(), "R U R' U' U R U' R' U' F' U F F R U R' U' F'")} locale={locale} large /><div class="stage-goals">{chapters.map(chapter => <div><LayerDiagram layer={chapter.layer} label={ko ? `${chapter.layer}층까지의 목표` : `Goal: ${chapter.layer} solved layers`} /><span>{ko ? `${chapter.layer}층` : `Layer ${chapter.layer}`}</span></div>)}</div><p class="stage-caption">{ko ? '화면에서 보고, 내 큐브에서 확인해요.' : 'Watch the example. Check the cube in your hands.'}</p></div>
  </section>
  <div class="completion-message" data-finished hidden><h2>{ko ? '여섯 면을 모두 맞췄어요!' : 'You solved all six faces!'}</h2><p>{ko ? '다시 연습할 때는 필요한 단계부터 골라보세요.' : 'Choose any step when you want to practice again.'}</p></div>
  <details class="stage-finder" data-stage-finder>
    <summary><span>{ko ? '내 큐브는 어디까지 맞았나요?' : 'How far have you got?'}</span><span class="finder-hint">{ko ? '시작 지점 찾기' : 'Find a starting point'}</span></summary>
    <div class="finder-body" id="start-point"><p>{ko ? '위에서부터 읽고, 내 큐브가 시작 조건에 맞는 단계를 골라요. 헷갈리면 흰 십자부터 확인해요.' : 'Read from the top and choose a lesson whose starting conditions match your cube. If unsure, begin with the white cross.'}</p><ol class="milestone-list">{lessons.map((lesson, i) => <li><a data-entry-slug={lesson.slug} href={`${base}/learn/${lesson.slug}/`}><span class="milestone-number" aria-hidden="true">{i + 1}</span><div><strong>{entryLabels[i]}</strong><p>{text(guidance[lesson.slug].before, locale)}</p><span class="milestone-destination">{text(lesson.title, locale)}</span></div><svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m9 5 7 7-7 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a></li>)}</ol></div>
  </details>
  <section class="curriculum" id="steps"><div class="curriculum-heading"><div class="section-intro"><h2>{ko ? '한 층씩, 일곱 단계' : 'Three layers. Seven steps.'}</h2><p>{ko ? '한 조각을 맞춘 뒤 같은 방법으로 반복해요.' : 'Place one piece, then repeat the method.'}</p></div><div class="course-progress" hidden data-course-progress={lessons.map(lesson => lesson.slug).join(',')}><div><span>{ko ? '직접 확인한 단계' : 'Personally checked'}</span><strong data-progress-count>0 / {lessons.length}</strong></div><progress value="0" max={lessons.length} aria-label={ko ? '직접 확인한 본 수업' : 'Main lessons personally checked'}></progress><p>{ko ? '이 브라우저의 기록이에요.' : 'Saved in this browser.'}</p></div></div>
    {chapters.map(chapter => <section class="chapter" aria-labelledby={`chapter-${chapter.layer}`}><div class="chapter-heading"><LayerDiagram layer={chapter.layer} label={ko ? `${chapter.layer}층까지 맞춘 옆면` : `${chapter.layer} solved layers`} /><div><h3 id={`chapter-${chapter.layer}`}>{chapter.title}</h3><p>{chapter.note}</p></div></div><ol class="lesson-list">{lessons.filter(lesson => chapter.slugs.includes(lesson.slug)).map(lesson => <li data-progress-slug={lesson.slug}><a href={`${base}/learn/${lesson.slug}/`}><span class="lesson-number">{String(lessons.indexOf(lesson) + 1).padStart(2, '0')}</span><div><h4>{text(lesson.title, locale)}</h4><p>{text(lesson.goal, locale)}</p></div><span class="completed-label" data-completed hidden>{ko ? '완료' : 'Done'}</span><svg class="lesson-open" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m9 5 7 7-7 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a></li>)}</ol></section>)}
  </section>
  <section class="course-help" id="help"><div><h2>{ko ? '헷갈리는 부분이 있나요?' : 'Need a closer look?'}</h2><p>{ko ? '지금 필요한 설명만 찾아보세요.' : 'Find just the explanation you need.'}</p><div class="reference-links"><a href={`${base}/learn/ready/`}>{ko ? '조각 이름과 잡는 방향' : 'Pieces and holding your cube'}</a><a href={`${base}/learn/daisy/`}>{ko ? '흰 조각을 위로 모으는 방법' : 'Gathering white edges on top'}</a></div></div><div><details class="help-disclosure"><summary>{ko ? '내 큐브의 색이 화면과 달라요' : 'My cube has a different pattern'}</summary><div><p>{ko ? '전체 색 배치가 같을 필요는 없어요. 이번에 찾는 조각과 가까운 가운데 색을 비교하세요. 화면은 직접 돌려 보는 예시예요.' : 'The whole pattern does not need to match. Compare the piece you are working on with the nearby centers. The screen shows a demonstration.'}</p></div></details><details class="help-disclosure"><summary>{ko ? '학습 기록은 어디에 저장되나요?' : 'Where is my progress saved?'}</summary><div><p>{ko ? '이 기기의 브라우저에 저장돼요. 같은 브라우저로 돌아오면 이어서 볼 수 있어요. 사이트 데이터를 지우면 기록도 사라져요.' : 'In this browser on this device. Return here to resume. Clearing site data removes the record.'}</p></div></details></div></section>
</div>
<script>
  import { readProgress } from '../lib/progress';
  try {
    const progress = readProgress(localStorage, (document.body.dataset.lessonSlugs ?? '').split(',').filter(Boolean));
    const message = document.querySelector<HTMLElement>('[data-finished]');
    if (message && progress?.completed.includes('finish') && new URLSearchParams(location.search).has('finished')) message.hidden = false;
  } catch { /* 저장소를 사용할 수 없어도 학습 목록은 표시한다. */ }
</script>
