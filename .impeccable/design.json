      "css": ".ds-progress{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:8px;font-family:var(--font-body,'NamuSansSubset','Apple SD Gothic Neo','Malgun Gothic',sans-serif);}.ds-progress a{display:flex;align-items:center;gap:10px;padding:10px;text-decoration:none;border-bottom:2px solid var(--color-rule,#cfd9e5);font-size:.78rem;min-height:48px;color:var(--color-muted,#53647a)}.ds-progress a[aria-current]{color:var(--color-accent,#2549df);border-color:var(--color-accent,#2549df);font-weight:700}.ds-progress a:hover{background:var(--color-paper-2,#edf1f7)}.ds-progress a:focus-visible{outline:3px solid var(--color-focus,#2549df);outline-offset:4px}@media(max-width:1000px){.ds-step-name{display:none}.ds-progress a{justify-content:center}}@media(max-width:680px){.ds-progress{gap:4px}.ds-progress a{padding:8px 4px;font-size:.85rem}}"
