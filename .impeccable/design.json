      "css": ".ds-views{display:flex;gap:8px;flex-wrap:wrap}.ds-views button{min-height:44px;border:1px solid var(--color-field-edge,#6c7c90);border-radius:var(--radius-input,8px);padding:8px 12px;font-size:.8rem;background:var(--color-card,#ffffff);color:var(--color-ink,#172b44);cursor:pointer;font-family:var(--font-body,'NamuSansSubset','Apple SD Gothic Neo','Malgun Gothic',sans-serif);}.ds-views button[aria-pressed=true]{background:var(--color-accent,#2549df);color:var(--color-accent-ink,#ffffff);border-color:var(--color-accent,#2549df)}.ds-views button:active:not(:disabled){transform:translateY(1px)}.ds-views button:focus-visible{outline:3px solid var(--color-focus,#2549df);outline-offset:4px}.ds-views button:disabled{opacity:.45;cursor:not-allowed}"
