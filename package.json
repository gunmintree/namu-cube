{
    "name": "namu-cube",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.23.4"
    },
    "scripts": {
        "dev": "astro dev --host 127.0.0.1 --port 4323",
        "build": "astro build",
        "preview": "astro preview --host 127.0.0.1 --port 4323",
        "check": "astro check",
        "test": "node --experimental-strip-types --test tests/*.test.ts",
        "render:cases": "node scripts/render-case-previews.mjs",
        "test:site": "node scripts/render-case-previews.mjs --check && node scripts/check-site.mjs",
        "test:browser": "node scripts/browser-check.mjs"
    },
    "dependencies": {
        "astro": "7.4.7"
    },
    "devDependencies": {
        "@astrojs/check": "0.9.12",
        "puppeteer-core": "25.16.0",
        "typescript": "~5.9.3"
    }
}
